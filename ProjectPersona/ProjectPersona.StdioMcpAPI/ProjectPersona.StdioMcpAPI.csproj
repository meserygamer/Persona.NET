    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
      <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
      <PackageReference Include="Serilog" Version="4.4.0" />
      <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ProjectPersona.Application\ProjectPersona.Application.csproj" />
