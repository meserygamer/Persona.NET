{
  // Путь до .db файла из папки сгенерированной CliTools generate-type-artifacts
  "typeSourceIndexPath": "Software\\type-source-index\\type-source-index.db",
  // Отключить/Включить RAG поиск на уровне инструментов для агента
  "ragSearchEnabled": true,
  // Настройки llama (Необязательны при "ragSearchEnabled": false)
  "llama": {
    // Путь к модели эмбедингов в gguf формате
    "modelPath": "Software\\ProjectPersona\\embeddinggemma-2-Q8_0.gguf",
    // Путь к папке с llama сборкой
    "nativeLibraryDirectory": "Software\\ProjectPersona\\llama-b12359-bin-win-vulkan-x64",
    // Размер куска для формирования RAG документа
    "batchSize": 2048,

    // Последующие параметры относятся к llama и о них лучше прочитать у них (Параметры по умолчанию дают наибольшую производительность при "batchSize": 2048 и embeddinggemma-2-Q8_0)
    "nCtx": 2048,
    "nBatch": 2048,
    "nUbatch": 2048,
    "nSeqMax": 16,
    "nThreads": 8,
    "nThreadsBatch": 8,
    "nGpuLayers": 99,
    "devices": "Vulkan0",
    "flashAttn": "on"
  },
  // Настройки lanceDb (Необязательны при "ragSearchEnabled": false)
  "lanceDb": {
    // Путь к папке сгенерированной CliTools vectorize-type-source-index
    "pathToLanceDb": "Software\\ProjectPersona\\vector-store",
    // Число измерений генерируемых моделью
    "vectorDimension": 768
  }
}
